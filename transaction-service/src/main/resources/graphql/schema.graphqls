type Query {
  transactions: [Transaction!]!
  transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
  createTransaction(accountId: ID!, currency: String!, amount: BigDecimal!): Transaction!
  transfer(fromAccountId: ID!, toAccountId: ID!, amount: BigDecimal!, currency: String!): [Transaction!]!
}

type Transaction {
  id: ID!
  accountId: ID!
  currency: String!
  amount: BigDecimal!
  type: String!
  merchantCategory: String!
  createdAt: String!
}
